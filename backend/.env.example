# ============ 服务 ============
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
DATA_DIR=./data
DB_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
WORKSPACE_DIR=./data/workspace
REPORT_DIR=./data/reports

# ============ 鉴权 ============
EXTERNAL_API_KEY=change-me-ext
ADMIN_API_KEY=change-me-admin

# 管理台前端跨域白名单（逗号分隔；Vite 开发/预览端口已默认包含）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ============ LLM 网关（OpenAI 兼容） ============
LLM_MODE=real
LLM_MAIN_BASE_URL=https://your-gateway.example/v1
LLM_MAIN_API_KEY=sk-xxx
LLM_MAIN_MODEL=deepseek-v4-flash
LLM_VISION_BASE_URL=https://your-gateway.example/v1
LLM_VISION_API_KEY=sk-xxx
LLM_VISION_MODEL=qwen3.7-flash
LLM_CHEAP_MODEL=
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# 推理型模型的"思考过程 + 正文"共享该预算；过小会导致正文为空（finish_reason=length）
LLM_MAX_COMPLETION_TOKENS=4096
# 识图模型单独预算（qwen 思考过程较长；不足时正文为空且不作为缓存）
LLM_VISION_MAX_COMPLETION_TOKENS=8192
LLM_TEMPERATURE=0
LLM_REASONING_PASSTHROUGH=true

# ============ Tavily ============
TAVILY_API_KEY=tvly-xxx
TAVILY_MAX_RESULTS=4
TAVILY_SEARCH_DEPTH=basic

# ============ RAG ============
KB_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/models
# 国内镜像（首次下载约 95MB）。若本机开代理导致下载卡住，可对 hf-mirror 直连：
#   bash: NO_PROXY=hf-mirror.com python scripts/download_models.py
# 镜像不支持 Xet，程序已自动设置 HF_HUB_DISABLE_XET=1
HF_ENDPOINT=https://hf-mirror.com
KB_DIR=./data/kb
KB_SEED_DIR=./kb_seed
CHROMA_DIR=./data/chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_CANDIDATES=20
RAG_TOP_K=4
RAG_RRF_K=60
RAG_W_DENSE=1.0
RAG_W_BM25=0.8
RAG_MIN_DENSE_SCORE=0.35
RAG_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# 先前案例（人工判决沉淀，独立 Chroma 集合 + BM25）
PRIOR_CASE_ENABLED=true
PRIOR_CASE_TOP_K=3
PRIOR_CASE_COLLECTION=prior_case_chunks

# ============ 预算 / 成本闸门 ============
BUDGET_MAX_LLM_CALLS=12
BUDGET_MAX_TOOL_CALLS=10
BUDGET_MAX_VISION_CALLS=6
BUDGET_MAX_TAVILY_CALLS=3
BUDGET_MAX_PROMPT_TOKENS=60000
BUDGET_MAX_RUN_COST=1.00
MAX_INVESTIGATE_LOOPS=2
# DeepSeek Flash 谷值（CNY / 1K tokens，官方 2026-09-10 价格）
# 缓存命中输入 0.02 元/M、缓存未命中 1 元/M、输出 4 元/M
PRICING_MAIN_INPUT_PER_1K=0.001
PRICING_MAIN_INPUT_CACHE_HIT_PER_1K=0.00002
PRICING_MAIN_OUTPUT_PER_1K=0.004
# 识图模型（qwen）单独计价，按你的网关账单替换
PRICING_VISION_INPUT_PER_1K=0.002
PRICING_VISION_OUTPUT_PER_1K=0.004

# ============ 图片本地检测 ============
PHASH_HAMMING_THRESHOLD=8
# 图片重复排查：pHash 历史图库比对（duplicate_image 证据）与 find_similar_claim_images 工具
IMAGE_DUPLICATE_CHECK_ENABLED=true

# ============ 第三方 AI 生成检测（Sightengine） ============
# 所有图片先做 AI 生成预检；高分只作线索，需识图模型定位并与诉求比对。结果按图缓存。
SIGHTENGINE_ENABLED=true
SIGHTENGINE_API_USER=your-user-id
SIGHTENGINE_API_SECRET=your-secret
SIGHTENGINE_MODEL=genai
# ≥ 该分数才纳入“是否为 AI 生成”的考量
SIGHTENGINE_AI_THRESHOLD=0.90
# ≥ 该分数才触发“不得判真实，至少疑似欺诈”的裁决硬约束
SIGHTENGINE_CONSTRAINT_THRESHOLD=0.95
SIGHTENGINE_TIMEOUT_S=30

# ============ 观测 ============
SSE_HEARTBEAT_S=15
EVENT_RETENTION_DAYS=30
EVENT_FLUSH_INTERVAL_MS=50
EVENT_FLUSH_BATCH=20
OBS_THOUGHT_TOKEN_STREAM=false
SSE_POLL_FALLBACK=false

# ============ 演示平台 ============
DEMO_SEED_ON_START=true
CALLBACK_TIMEOUT_S=10

# ============ 触发判断 ============
# 参与判定的最近消息条数（窗口）：客服场景中图片与文字常分开发送，
# 判定时先看该窗口文本（关键词 + 语义），再在窗口内取图作为证据
TRIGGER_WINDOW_MESSAGES=5
# 去重：相同证据指纹在冷却期内不重复建运行（0=不因时间重新触发）
TRIGGER_DEDUP_ENABLED=true
TRIGGER_DEDUP_TTL_MINUTES=30
