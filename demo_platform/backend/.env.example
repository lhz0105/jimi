# ============ 演示平台服务 ============
DEMO_HOST=127.0.0.1
DEMO_PORT=8001
DEMO_LOG_LEVEL=INFO

# 本服务对外的基地址（agent 会按该地址下载图片，需 agent 可访问）
DEMO_PUBLIC_BASE_URL=http://127.0.0.1:8001

# ============ 数据 ============
DEMO_DATA_DIR=./data

# ============ 对接的 Agent 服务（只使用其对外接口 /api/v1/analyze） ============
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_API_KEY=change-me-ext

# 组装 inline 载荷时携带的最近消息条数与图片窗口条数
CONTEXT_WINDOW_MESSAGES=8
CONTEXT_WINDOW_IMAGES=5

# ============ CORS ============
DEMO_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
